[Unit]
Description=Korzina Market chat image retention cleanup
Wants=docker.service
After=network.target docker.service

[Service]
Type=oneshot
User=shop
Group=shop
WorkingDirectory=/opt/korzinamarket
EnvironmentFile=/etc/korzinamarket/api.env
ExecStart=/usr/bin/node /opt/korzinamarket/apps/api/dist/order/chat-cleanup.cli.js
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/korzinamarket/uploads/chat
