[Unit]
Description=Korzina Market API
Wants=docker.service
After=network.target docker.service

[Service]
Type=simple
User=shop
Group=shop
WorkingDirectory=/opt/korzinamarket
EnvironmentFile=/etc/korzinamarket/api.env
ExecStart=/usr/bin/node /opt/korzinamarket/apps/api/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/korzinamarket/uploads

[Install]
WantedBy=multi-user.target
