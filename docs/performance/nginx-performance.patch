--- a/deploy/nginx.conf
+++ b/deploy/nginx.conf
@@ -15,6 +15,13 @@
     listen 80;
     listen [::]:80;
     server_name korzinamarket.ru;
+
+    # Proposal only: transfer to the ACTIVE TLS server after review.
+    gzip on;
+    gzip_vary on;
+    gzip_proxied any;
+    gzip_min_length 1024;
+    gzip_types text/css application/javascript application/json application/xml image/svg+xml;
 
     client_max_body_size 6m;
 
@@ -51,11 +58,29 @@
         add_header Cache-Control "no-store" always;
     }
 
+    # Only write-once public product filenames; never chat/private API.
+    location ~ "^/uploads/products/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.webp$" {
+        proxy_pass http://127.0.0.1:4001;
+        proxy_cache off;
+        proxy_hide_header Cache-Control;
+        # Without 'always': failed/404 responses must not be cached for a year.
+        add_header Cache-Control "public, max-age=31536000, immutable";
+    }
+
     location /uploads/ {
         proxy_pass http://127.0.0.1:4001;
     }
 
+    location ^~ /_nuxt/ {
+        proxy_pass http://127.0.0.1:3000;
+        proxy_cache off;
+        # Preserve Nitro's immutable headers and gzip/Brotli negotiation.
+    }
+
     location / {
         proxy_pass http://127.0.0.1:3000;
+        proxy_cache off;
+        proxy_hide_header Cache-Control;
+        add_header Cache-Control "private, no-store" always;
     }
 }
