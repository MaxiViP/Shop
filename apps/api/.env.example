ADMIN_PHONE=
ADMIN_PASSWORD=
# Read-only product image metadata/HTTP variants. Disabled unless exactly true.
PRODUCT_IMAGE_VARIANTS_ENABLED=false
# Required private absolute path when enabled; never inside UPLOAD_DIR.
PRODUCT_IMAGE_STATE_DIR=
# Optional absolute public root containing variants/v1; defaults to existing UPLOAD_DIR.
PRODUCT_IMAGE_VARIANTS_DIR=
# Empty/false: ignore forwarded client IP. Otherwise only explicit trusted IP/CIDR.
# Example for a single local reverse proxy: 127.0.0.1/32,::1/128
TRUST_PROXY=

# DEMO returns the OTP to the browser. SMS requires an OtpSmsProvider adapter.
# Keep the legacy phone-only test login disabled.
OTP_DELIVERY_MODE=
TEST_PHONE_AUTH_ENABLED=false
PAYMENT_RECIPIENT_NAME=
PAYMENT_PHONE=
PAYMENT_BANK_NAME=
PAYMENT_CARD_NUMBER=
PAYMENT_SBP_LINK=
PAYMENT_QR_IMAGE_URL=

# Order notifications only, unrelated to OTP. A real OrderSmsProvider adapter is required.
ORDER_SMS_ENABLED=
ORDER_SMS_PROVIDER=
ORDER_SMS_API_URL=
ORDER_SMS_API_KEY=
ORDER_SMS_SENDER=
ORDER_SITE_URL=
