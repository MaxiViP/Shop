{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moscow Market research dataset",
  "type": "object",
  "required": [
    "schemaVersion",
    "datasetId",
    "researchDateMoscow",
    "productCount",
    "categories",
    "sources",
    "products",
    "pricePolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "datasetId": {
      "type": "string"
    },
    "researchDateMoscow": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "productCount": {
      "type": "integer",
      "minimum": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slug",
          "name",
          "sort"
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sourceId",
          "url",
          "reference",
          "sourceType"
        ]
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "catalogKey",
          "slug",
          "name",
          "description",
          "categorySlug",
          "unit",
          "priceQty",
          "step",
          "min",
          "portionQty",
          "sellerPrice",
          "priceStatus",
          "marketPointSlug",
          "active",
          "availability",
          "priceReference",
          "photo",
          "priceSelection"
        ],
        "properties": {
          "catalogKey": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 180
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "unit": {
            "enum": [
              "GRAM",
              "PIECE",
              "BUNCH",
              "PACK"
            ]
          },
          "priceQty": {
            "type": "integer",
            "minimum": 1
          },
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "min": {
            "type": "integer",
            "minimum": 1
          },
          "portionQty": {
            "type": "integer",
            "minimum": 1
          },
          "sellerPrice": {
            "type": "integer",
            "minimum": 1
          },
          "priceStatus": {
            "enum": [
              "ESTIMATED",
              "SOURCE",
              "AUDITED"
            ]
          },
          "marketPointSlug": {
            "const": "vegetables-fruits-east"
          },
          "sourceCheckedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "availability": {
            "type": "object",
            "required": [
              "profile",
              "assessment",
              "supplierYearRoundAvailabilityConfirmed",
              "note"
            ],
            "properties": {
              "profile": {
                "enum": [
                  "YEAR_ROUND_CORE",
                  "YEAR_ROUND_VARIABLE"
                ]
              },
              "assessment": {
                "const": "INFERRED_NOT_12_MONTH_AUDIT"
              }
            }
          },
          "priceReference": {
            "type": "object",
            "required": [
              "currency",
              "unit",
              "priceQty",
              "offers",
              "requiresRecheck"
            ]
          },
          "photo": {
            "type": "object",
            "required": [
              "status",
              "fileName",
              "alt",
              "subject"
            ]
          },
          "priceSelection": {
            "type": "object",
            "required": [
              "method",
              "sourceId",
              "userAuthorizedLaunchEstimate"
            ]
          }
        }
      }
    },
    "pricePolicy": {
      "type": "object"
    }
  }
}
