generator client {
  provider = "prisma-client"
  output   = "../src/db/gen"
}

datasource db {
  provider = "postgresql"
}

enum Unit {
  GRAM
  PIECE
  BUNCH
  PACK
}

enum UserRole {
  USER
  SELLER
  ADMIN
}

enum OrderItemStatus {
  PENDING
  PICKED
  MISSING
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String
  slug   String  @unique
  active Boolean @default(true)
  sort   Int     @default(0)

  parentId Int?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?

  price      Int
  priceQty   Int  @default(1)
  unit       Unit
  step       Int  @default(1)
  min        Int  @default(1)
  portionQty Int

  active Boolean @default(true)
  sort   Int     @default(0)

  orderItems OrderItem[]
  proposals  OrderIssue[]
  favorites  Favorite[]

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  images ProductImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id      Int     @id @default(autoincrement())
  url     String
  alt     String?
  sort    Int     @default(0)
  visible Boolean @default(true)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model User {
  canceledOrders OrderCancellation[] @relation("CanceledBy")
  restoredOrders OrderCancellation[] @relation("RestoredBy")
  extras         OrderExtra[]
  id             Int                 @id @default(autoincrement())
  phone          String?             @unique
  name           String?
  verifiedAt     DateTime?
  role           UserRole            @default(USER)

  orders            Order[]
  addresses         Address[]
  telegramIdentity  TelegramIdentity?
  sessions          Session[]
  favorites         Favorite[]
  settingsUpdates   ShopSettings[]
  confirmedPayments OrderPayment[]
  issues            OrderIssue[]
  messages          OrderChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id       Int     @id @default(autoincrement())
  label    String
  city     String
  street   String
  house    String
  flat     String?
  entrance String?
  floor    String?
  intercom String?
  comment  String?

  lat    Float?
  lng    Float?
  fiasId String?

  isDefault Boolean @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Otp {
  id        String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String   @id
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  NEW
  CONFIRMED
  ASSEMBLING
  READY
  DELIVERING
  COMPLETED
  CANCELED
}

enum DeliveryProvider {
  YANDEX
  OTHER
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELED
}

model Order {
  cancellations OrderCancellation[]
  extras        OrderExtra[]
  id            Int                 @id @default(autoincrement())
  publicId      String              @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  type                OrderType
  status              OrderStatus   @default(NEW)
  weightToleranceBps  Int           @default(1000)
  assemblyFinalizedAt DateTime?
  payment             OrderPayment?

  customerName  String
  customerPhone String

  city     String?
  street   String?
  house    String?
  flat     String?
  entrance String?
  floor    String?
  intercom String?
  comment  String?

  deliveryAt DateTime?

  subtotal      Int
  deliveryPrice Int?
  total         Int?

  finalSubtotal Int?
  finalTotal    Int?

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  guestSessionId String?
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)

  items                 OrderItem[]
  issues                OrderIssue[]
  messages              OrderChatMessage[]
  notifications         OrderNotification[]
  customerReadMessageId Int                 @default(0)
  staffReadMessageId    Int                 @default(0)
  customerUnread        Int                 @default(0)
  staffUnread           Int                 @default(0)

  delivery        Delivery?
  deliveryAttempt DeliveryAttempt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([guestSessionId])
  @@index([status])
  @@index([createdAt])
}

enum ExtraStatus {
  ACTIVE
  CANCELED
}

model OrderExtra {
  id          Int         @id @default(autoincrement())
  orderId     Int
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title       String      @db.VarChar(120)
  comment     String?     @db.VarChar(1000)
  quantity    Int
  unitPrice   Int
  amount      Int
  status      ExtraStatus @default(ACTIVE)
  version     Int         @default(1)
  createdById Int?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  canceledAt  DateTime?

  @@index([orderId, status])
}

model Delivery {
  id Int @id @default(autoincrement())

  provider DeliveryProvider
  status   DeliveryStatus   @default(PENDING)

  externalOrderId   String?
  trackingUrl       String?
  courierName       String?
  courierPhone      String?
  price             Int?
  providerStatus    String?
  providerUpdatedAt DateTime?
  syncedAt          DateTime?

  publicToken String @unique

  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum DeliveryAttemptState {
  RESERVED
  CREATED
  ACCEPTED
  ACTIVE
  NEEDS_REVIEW
}

// One durable booking identity per order. Never silently replace an unknown claim.
model DeliveryAttempt {
  orderId         Int                  @id
  order           Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        DeliveryProvider
  requestId       String               @unique @db.Uuid
  externalOrderId String?              @unique
  state           DeliveryAttemptState @default(RESERVED)
  requestBody     String?              @db.Text
  providerStatus  String?
  lastError       String?
  leaseToken      String?              @db.Uuid
  leaseUntil      DateTime?
  acceptedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([state, leaseUntil])
}

model OrderItem {
  id Int @id @default(autoincrement())

  productName String
  productSlug String
  image       String?

  price    Int
  priceQty Int
  unit     Unit

  status OrderItemStatus @default(PENDING)

  qty       Int
  actualQty Int?
  total     Int

  actualTotal    Int?
  issue          OrderIssue? @relation("ItemIssue")
  replacementFor OrderIssue? @relation("IssueReplacement")

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model GuestSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())

  orders Order[]

  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Favorite {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

model ShopSettings {
  minDeliverySubtotal     Int      @default(300000)
  maxOrderExtraUnitPrice  Int      @default(500000)
  maxOrderExtrasTotal     Int      @default(1000000)
  deliveryEnabled         Boolean  @default(true)
  pickupEnabled           Boolean  @default(true)
  id                      Int      @id @default(1)
  weightToleranceBps      Int      @default(1000)
  customerResponseMinutes Int      @default(10)
  updatedAt               DateTime @updatedAt
  updatedById             Int?
  updatedBy               User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

enum PaymentStatus {
  AWAITING
  REPORTED
  PAID
  CANCELED
}

enum PaymentMethod {
  SBP
  QR
  CARD_TRANSFER
}

model OrderPayment {
  id            Int            @id @default(autoincrement())
  orderId       Int            @unique
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Int
  status        PaymentStatus  @default(AWAITING)
  method        PaymentMethod?
  reportedAt    DateTime?
  confirmedAt   DateTime?
  confirmedById Int?
  confirmedBy   User?          @relation(fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum IssueType {
  WEIGHT_DEVIATION
  MISSING_ITEM
  REPLACEMENT
}

enum IssueStatus {
  WAITING_CUSTOMER
  WAITING_SELLER
  RESOLVED
  CANCELED
}

enum IssueResolution {
  ACCEPT_ACTUAL
  REQUEST_REDUCE
  REMOVE_ITEM
  ACCEPT_REPLACEMENT
  SELLER_ADJUSTED
  CANCEL_ORDER
}

model OrderIssue {
  suspendedStatus     IssueStatus?
  suspendedResolution IssueResolution?
  suspendedResolvedAt DateTime?
  id                  Int                 @id @default(autoincrement())
  orderId             Int
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId         Int                 @unique
  orderItem           OrderItem           @relation("ItemIssue", fields: [orderItemId], references: [id], onDelete: Cascade)
  type                IssueType
  status              IssueStatus         @default(WAITING_CUSTOMER)
  version             Int                 @default(1)
  requestedQty        Int
  actualQty           Int?
  approvedActualQty   Int?
  resolution          IssueResolution?
  resolvedAt          DateTime?
  createdById         Int?
  createdBy           User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  proposedProductId   Int?
  proposedProduct     Product?            @relation(fields: [proposedProductId], references: [id], onDelete: SetNull)
  proposedName        String?
  proposedSlug        String?
  proposedPrice       Int?
  proposedPriceQty    Int?
  proposedUnit        Unit?
  proposedQty         Int?
  proposedImageUrl    String?
  replacementItemId   Int?                @unique
  replacementItem     OrderItem?          @relation("IssueReplacement", fields: [replacementItemId], references: [id], onDelete: SetNull)
  messages            OrderChatMessage[]
  notifications       OrderNotification[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([orderId, status])
}

model OrderCancellation {
  id             Int             @id @default(autoincrement())
  orderId        Int
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus     OrderStatus
  paymentStatus  PaymentStatus?
  deliveryStatus DeliveryStatus?
  reason         String?         @db.VarChar(1000)
  canceledAt     DateTime        @default(now())
  canceledById   Int?
  canceledBy     User?           @relation("CanceledBy", fields: [canceledById], references: [id], onDelete: SetNull)
  canceledByRole UserRole
  restoredAt     DateTime?
  restoredById   Int?
  restoredBy     User?           @relation("RestoredBy", fields: [restoredById], references: [id], onDelete: SetNull)
  restoredByRole UserRole?

  @@index([orderId, id])
}

enum MessageAuthor {
  CUSTOMER
  SELLER
  ADMIN
  SYSTEM
}

model OrderChatMessage {
  id           Int           @id @default(autoincrement())
  orderId      Int
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  issueId      Int?
  issue        OrderIssue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  authorType   MessageAuthor
  recipient    String        @default("both")
  authorUserId Int?
  authorUser   User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  text         String        @db.VarChar(2000)
  createdAt    DateTime      @default(now())

  @@index([orderId, id])
}

enum NotificationType {
  ACTION_REQUIRED
  PAYMENT_READY
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  UNCONFIGURED
  CANCELED
}

model OrderNotification {
  id           Int                @id @default(autoincrement())
  orderId      Int
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  issueId      Int?
  issue        OrderIssue?        @relation(fields: [issueId], references: [id], onDelete: SetNull)
  issueVersion Int?
  type         NotificationType
  status       NotificationStatus @default(PENDING)
  dedupeKey    String             @unique
  attempts     Int                @default(0)
  error        String?
  sentAt       DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([orderId, status])
}

model TelegramIdentity {
  id             Int      @id @default(autoincrement())
  telegramUserId BigInt   @unique
  username       String?
  firstName      String?
  lastName       String?
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Short-lived consumed authentication proofs; never store raw Telegram payloads.
model TelegramAuthReplay {
  tokenHash String   @id
  expiresAt DateTime

  @@index([expiresAt])
}
